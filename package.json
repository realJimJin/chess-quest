  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "node --experimental-strip-types scripts/db-migrate.mjs",
    "test:extraction": "extraction/.venv/bin/python -m pytest extraction/tests -q -p no:warnings",
    "extract": "cd extraction && .venv/bin/python -m csx.cli",
    "build:ios": "bash scripts/build-ios.sh",
    "ios:open": "cap open ios",
    "check:ui-export": "node scripts/check-ui-export.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.33.0",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "aws4fetch": "^1.0.20",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.18",
    "next": "16.4.6",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
