# Accounts and sync. Leave all of this unset and the app runs local-only.

# Postgres. For local development an embedded database works: pglite:.data/pg
DATABASE_URL=
# Optional role without BYPASSRLS that requests switch to (created by npm run db:migrate).
DATABASE_APP_ROLE=

# Auth0 "Regular Web Application". Allowed callback URL: <APP_BASE_URL>/auth/callback
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Optional Auth0 API identifier. Set it to accept bearer access tokens (the iOS app).
AUTH0_AUDIENCE=
