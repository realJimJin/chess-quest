# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
extraction/.venv
extraction/out
__pycache__
.pytest_cache
out
ios/App/App/public
ios/DerivedData
ios/build
appstore/screenshots/raw
*.ipa
*.xcarchive
exercises.json
*.pdf
!extraction/tests/synthetic-fixture.pdf

# signing material and keys: never commit
*.p12
*.cer
*.p8
*.mobileprovision
*.provisionprofile
*.keystore
*.jks
AuthKey_*.p8
fastlane/report.xml

# iOS build output
Pods/
DerivedData/
*.dSYM.zip
xcuserdata/

# book scans and private study data stay local
*.epub
*.djvu
private/

# Full user books and encrypted one-time deliveries never go in the public repo.
/public/private-import/
/public/pdf/
